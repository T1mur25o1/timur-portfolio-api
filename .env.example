PORT=3000
NODE_ENV=development

# MongoDB connection string. Use MONGODB_URI=memory to run locally without a
# database (content resets on every restart; refused when NODE_ENV=production).
# Create a free (M0) cluster at
# https://www.mongodb.com/cloud/atlas/register, add a database user, allow
# network access from 0.0.0.0/0, then copy the string from Connect > Drivers.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Optional: database name to use within the cluster. Defaults to "portfolio".
MONGODB_DB=portfolio

# Secret used to sign admin JWTs. Set this to any long random string.
JWT_SECRET=replace-with-a-long-random-string

# Bcrypt hash of your admin password. Generate one with:
#   node scripts/hash-password.js "your-password-here"
# then paste the printed hash below.
ADMIN_PASSWORD_HASH=

# Optional: public URL of the site, used for absolute Open Graph links in
# link previews. If unset, it's derived from the incoming request.
# SITE_URL=https://your-app.onrender.com

# Optional: number of reverse-proxy hops to trust for the client IP (used by
# rate limiting). Defaults to 1 in production (Render), 0 locally.
# TRUST_PROXY=1

# Optional: get a Telegram message whenever someone uses the contact form.
# 1. Create a bot with @BotFather and paste its token here.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
