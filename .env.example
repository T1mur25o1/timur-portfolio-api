PORT=3000
NODE_ENV=development

# MongoDB connection string. Create a free (M0) cluster at
# https://www.mongodb.com/cloud/atlas/register, add a database user, allow
# network access from 0.0.0.0/0, then copy the string from Connect > Drivers.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Optional: database name to use within the cluster. Defaults to "portfolio".
MONGODB_DB=portfolio

# Secret used to sign admin JWTs. Set this to any long random string.
JWT_SECRET=replace-with-a-long-random-string

# Bcrypt hash of your admin password. Generate one with:
#   node scripts/hash-password.js "your-password-here"
# then paste the printed hash below.
ADMIN_PASSWORD_HASH=
